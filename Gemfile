source "https://rubygems.org"

# Production: GitHub Pages renders the site with the `github-pages` metapackage.
# Local dev: use modern Jekyll + just-the-docs directly so newer Ruby works.
# Both paths read `_config.yml`, which is the source of truth for theme + plugins.

group :jekyll_plugins do
  gem "jekyll", "~> 4.3"
  gem "just-the-docs"
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
  gem "jekyll-include-cache"
end

gem "webrick", "~> 1.8"
